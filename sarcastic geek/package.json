{
  "name": "sarcastic-geek",
  "version": "1.0.0",
  "description": "Sarcastic Geek - motion graphics with Remotion",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render",
    "render:mp4": "remotion render SarcasticGeek out/sarcastic-geek.mp4",
